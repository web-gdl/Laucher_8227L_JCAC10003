<?xml version="1.0" encoding="utf-8"?>
<!--
  Inicio «nocturno, música al centro» (propuesta 2) con fondo de los colores de la portada. Área de referencia 1024x534 dp: la barra del
  sistema del estéreo ya muestra hora, Wi-Fi, GPS, Bluetooth y USB, así que aquí no se repiten.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night">

    <!-- ===================== Pantalla principal ===================== -->
    <FrameLayout
        android:id="@+id/home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Fondo: colores de la portada muy difuminados, a toda la pantalla (ui/Backdrop.java).
             Si la canción no trae portada se queda el último fondo. -->
        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <!-- Oscurece la parte baja para que el dock se lea sobre cualquier fondo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/backdrop_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="26dp"
            android:paddingBottom="14dp">

            <!-- Música: toda la zona superior abre la app (pulsación larga: elegir app) -->
            <LinearLayout
                android:id="@+id/media_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/media_area_bg"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/media_cover"
                    android:layout_width="@dimen/cover_size"
                    android:layout_height="@dimen/cover_size"
                    android:background="@drawable/cover_round"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/text_dim" />

                <LinearLayout
                    android:layout_width="@dimen/media_text_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/media_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.2"
                        android:singleLine="true"
                        android:text="@string/media_now_playing" />

                    <TextView
                        android:id="@+id/media_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/media_title"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:text="@string/media_idle" />

                    <TextView
                        android:id="@+id/media_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/media_artist"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/media_open_hint" />

                    <ProgressBar
                        android:id="@+id/media_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="16dp"
                        android:progressDrawable="@drawable/progress_media"
                        android:max="1000"
                        android:progress="0" />

                    <LinearLayout
                        android:id="@+id/media_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/media_pos"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/media_dur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/media_prev"
                    style="@style/MediaButton"
                    android:layout_marginEnd="34dp"
                    android:src="@drawable/ic_skip_previous"
                    android:contentDescription="@string/previous" />

                <ImageButton
                    android:id="@+id/media_play"
                    style="@style/MediaButton"
                    android:layout_width="@dimen/media_btn_main"
                    android:layout_height="@dimen/media_btn_main"
                    android:padding="24dp"
                    android:background="@drawable/round_button_accent_bg"
                    android:tint="@color/bg"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/play" />

                <ImageButton
                    android:id="@+id/media_next"
                    style="@style/MediaButton"
                    android:layout_marginStart="34dp"
                    android:src="@drawable/ic_skip_next"
                    android:contentDescription="@string/next" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Dock: 6 favoritos en anillo + «Todas» -->
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== Panel "todas las apps" ===================== -->
    <LinearLayout
        android:id="@+id/apps_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/night"
        android:padding="@dimen/page_pad"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_apps_back"
                style="@style/HeaderButton"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="@string/all_apps"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/apps_count"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btn_toggle_hidden"
                style="@style/HeaderButton"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_visibility"
                android:tint="@color/text_dim"
                android:contentDescription="@string/show_hidden" />

            <ImageButton
                android:id="@+id/btn_screen_off"
                style="@style/HeaderButton"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_power"
                android:contentDescription="@string/screen_off" />

            <ImageButton
                android:id="@+id/btn_settings"
                style="@style/HeaderButton"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />

            <ImageButton
                android:id="@+id/btn_diag"
                style="@style/HeaderButton"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/diagnostics" />
        </LinearLayout>

        <GridView
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/gap"
            android:numColumns="6"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="@dimen/gap"
            android:verticalSpacing="@dimen/gap"
            android:listSelector="@android:color/transparent"
            android:fastScrollEnabled="false"
            android:scrollbarStyle="outsideOverlay"
            android:cacheColorHint="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
